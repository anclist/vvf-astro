---
import Button from './Button.astro'
import Card from './Card.astro'
import Eyebrow from './Eyebrow.astro'

export interface CtaLink {
  label: string
  href: string
}

export interface Props {
  tone: 'yellow' | 'pink' | 'blue'
  eyebrow?: string
  title: string
  body?: string
  cta?: CtaLink
  icon?: 'nutrition' | 'medical' | 'education' | 'none'
}

const { tone, eyebrow, title, body, cta } = Astro.props as Props
---

<Card tone={tone} shadow={false} class="p-6 flex flex-col h-full">
  {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
  <h3 class="mt-2 text-display-sm text-brand-navy">{title}</h3>
  {body && <p class="mt-2 text-ink-700 flex-1">{body}</p>}
  {
    cta && (
      <Button href={cta.href} variant="outline-navy" class="mt-4 self-start">
        {cta.label}
      </Button>
    )
  }
</Card>
