---
// Terms of Use and Donor Bill of Rights are intentionally omitted: those
// pages don't exist yet (copy not supplied). See front-end/spec.md:
// Privacy Policy page.
const socialLinks = [
  { label: 'Facebook', href: '#' },
  { label: 'Instagram', href: '#' },
  { label: 'X', href: '#' },
  { label: 'LinkedIn', href: '#' },
  { label: 'YouTube', href: '#' },
]
---

<footer class="bg-brand-navy text-white">
  <div class="container max-w-container mx-auto px-4 py-12 grid gap-10 md:grid-cols-3">
    <div>
      <p class="font-display text-xl">Victoria Venezuela</p>
      <p class="mt-4 text-sm text-white/80 max-w-xs">
        Victoria Venezuela Foundation is a 501(c)(3) non-profit organization. Contributions are tax-deductible under
        Internal Revenue Code Section 501(c)(3).
      </p>
      <p class="mt-4 text-sm text-white/80">
        Tax ID: 88-3282100<br />
        P.O. Box 268752<br />
        Weston, FL 33326
      </p>
      <div class="mt-4 inline-block border border-white/40 rounded px-3 py-2 text-xs text-white/80">
        Platinum Transparency 2026 — Candid
      </div>
    </div>

    <div class="grid grid-cols-2 gap-6 text-sm">
      <ul class="space-y-2 text-white/80">
        <li><a class="hover:text-white" href="/our-team">About us</a></li>
        <li><a class="hover:text-white" href="/sponsor-a-child">Our programs</a></li>
        <li><a class="hover:text-white" href="/ways-to-give">Get involved</a></li>
        <li><a class="hover:text-white" href="/ways-to-give">Donate now</a></li>
        <li><a class="hover:text-white" href="/blog">News updates</a></li>
      </ul>
      <ul class="space-y-2 text-white/80">
        <li><a class="hover:text-white" href="/our-team#volunteer">Volunteer</a></li>
        <li><a class="hover:text-white" href="/sponsor-a-child/children">Sponsor child</a></li>
        <li><a class="hover:text-white" href="/contact">Contact us</a></li>
        <li><a class="hover:text-white" href="/events">Events</a></li>
        <li><a class="hover:text-white" href="/corporate-sponsorships">Partnerships</a></li>
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold">Contact</p>
      <a class="block mt-2 text-sm text-white/80 hover:text-white" href="mailto:info@victoriavenezuelafoundation.org">
        info@victoriavenezuelafoundation.org
      </a>
      <div class="mt-4 flex gap-3">
        {
          socialLinks.map((s) => (
            <a href={s.href} aria-label={s.label} class="text-white/80 hover:text-white">
              <span class="sr-only">{s.label}</span>
              <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <circle cx="10" cy="10" r="9" fill="none" stroke="currentColor" stroke-width="1.2" />
              </svg>
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <div class="border-t border-white/20">
    <div class="container max-w-container mx-auto px-4 py-4 flex flex-col md:flex-row items-center justify-between gap-2 text-xs text-white/70">
      <p>© {new Date().getFullYear()} Victoria Venezuela Foundation. All rights reserved.</p>
      <a href="/privacy-policy" class="hover:text-white">Privacy policy</a>
    </div>
  </div>
</footer>
