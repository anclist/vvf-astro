---
import Button from './Button.astro'
import TextField from './TextField.astro'
import TextArea from './TextArea.astro'

export interface Props {
  defaultTopic?: string
}

const { defaultTopic } = Astro.props as Props

const topics = [
  { value: 'general', label: 'General inquiry' },
  { value: 'donation-support', label: 'Donation support' },
  { value: 'media-press', label: 'Media and press' },
  { value: 'corporate-partnerships', label: 'Corporate partnerships' },
]
---

<form class="grid gap-4" data-contact-form novalidate>
  <div class="grid sm:grid-cols-2 gap-4">
    <TextField required name="firstName" placeholder="First name" />
    <TextField required name="lastName" placeholder="Last name" />
  </div>
  <div class="grid sm:grid-cols-2 gap-4">
    <TextField required type="email" name="email" placeholder="Email" />
    <TextField name="phone" placeholder="Phone number" />
  </div>

  <label class="text-sm text-ink-700">
    What is this about?
    <select name="topic" class="mt-1 w-full rounded-pill px-4 py-2 border" data-topic-select>
      {topics.map((t) => (
        <option value={t.value} selected={t.value === defaultTopic}>
          {t.label}
        </option>
      ))}
    </select>
  </label>

  <TextArea name="message" required placeholder="Message" rows={5} />

  <label class="flex items-center gap-2 text-sm text-ink-700">
    <input type="checkbox" required name="privacyConsent" data-privacy-checkbox />
    I agree to the privacy policy
  </label>

  <Button type="submit" variant="primary-sky" size="lg" class="justify-self-start" data-submit disabled>
    Send message
  </Button>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const checkbox = form.querySelector<HTMLInputElement>('[data-privacy-checkbox]')
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')
    if (!checkbox || !submit) return

    const sync = () => {
      submit.disabled = !checkbox.checked
    }
    checkbox.addEventListener('change', sync)
    sync()

    form.addEventListener('submit', (e) => {
      if (!checkbox.checked) {
        e.preventDefault()
      }
    })
  })
</script>
