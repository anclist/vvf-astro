---
import type { TeamMemberItem } from '../lib/content/types'

export interface Props {
  member: TeamMemberItem
}

const { member } = Astro.props as Props
const linkable = member.tier === 'board' || member.tier === 'leader'
const Tag = linkable ? 'a' : 'div'
---

<Tag href={linkable ? `/our-team/${member.slug}` : undefined} class="block bg-white rounded-card p-5 shadow-sm text-center">
  <div class="w-20 h-20 mx-auto rounded-full bg-gray-200 overflow-hidden">
    {
      member.imageUrl ? (
        <img src={member.imageUrl} alt={member.name} class="w-full h-full object-cover" />
      ) : (
        <div class="w-full h-full flex items-center justify-center text-ink-500 text-xs">Photo</div>
      )
    }
  </div>
  <p class="mt-3 font-display text-brand-navy">{member.name}</p>
  <p class="text-sm text-ink-500">{member.role}</p>
  {member.bio && <p class="mt-2 text-sm text-ink-700">{member.bio}</p>}
</Tag>
