---
import type { ChildItem } from '../lib/content/types'
import Card from './Card.astro'

export interface Props {
  child: ChildItem
}

const { child } = Astro.props as Props
const birthdayLabel = child.birthday
  ? new Date(child.birthday).toLocaleDateString(undefined, { year: 'numeric', month: '2-digit', day: '2-digit' })
  : undefined
---

<div class="container max-w-container mx-auto px-4 py-8">
  <nav class="text-sm text-ink-500" aria-label="Breadcrumb">
    <a href="/sponsor-a-child/children" class="hover:text-brand-sky">Meet the children</a>
    <span class="mx-2">/</span>
    <span class="text-ink-700">{child.displayName}</span>
  </nav>

  <div class="mt-6 grid md:grid-cols-[1fr_1fr_1.2fr] gap-6">
    <div class="md:col-span-2 grid grid-cols-2 gap-4">
      <Card tone="blue" shadow={false} class="col-span-2 p-6">
        <p class="font-display text-xl text-brand-navy">{child.displayName}</p>
      </Card>
      <div class="col-span-2 h-64 rounded-card bg-gray-200 overflow-hidden">
        {
          child.imageUrl ? (
            <img src={child.imageUrl} alt={child.displayName} class="w-full h-full object-cover" />
          ) : (
            <div class="w-full h-full flex items-center justify-center text-ink-500 text-sm">Photo</div>
          )
        }
      </div>
      <Card tone="pink" shadow={false} class="p-5">
        <p class="font-semibold text-brand-navy">Age: {child.age} years old</p>
      </Card>
      {
        birthdayLabel && (
          <Card tone="yellow" shadow={false} class="p-5">
            <p class="font-semibold text-brand-navy">Birthday: {birthdayLabel}</p>
          </Card>
        )
      }
      {
        child.gender && (
          <Card tone="blue" shadow={false} class="p-5">
            <p class="font-semibold text-brand-navy">Gender: {child.gender}</p>
          </Card>
        )
      }
      {
        child.dream && (
          <Card tone="pink" shadow={false} class="p-5">
            <p class="font-semibold text-brand-navy">Dream: {child.dream}</p>
          </Card>
        )
      }
    </div>

    <div>
      <slot name="donation" />
    </div>
  </div>
</div>
