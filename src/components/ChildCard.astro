---
import type { ChildItem } from '../lib/content/types'

export interface Props {
  child: ChildItem
}

const { child } = Astro.props as Props
---

<a href={`/sponsor-a-child/children/${child.slug}`} class="block bg-gray-50 rounded-card overflow-hidden">
  <div class="relative h-40 bg-gray-200">
    {
      child.imageUrl ? (
        <img src={child.imageUrl} alt={child.displayName} class="w-full h-full object-cover" />
      ) : (
        <div class="w-full h-full flex items-center justify-center text-ink-500 text-sm">Photo</div>
      )
    }
  </div>
  <div class="p-4">
    <p class="text-xs text-ink-500 uppercase">{child.age} years old</p>
    <p class="mt-1 font-display text-brand-navy">{child.displayName}</p>
  </div>
</a>
