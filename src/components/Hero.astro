---
export interface CtaLink {
  label: string
  href: string
}

export interface Props {
  imageUrl?: string
  imageAlt?: string
  heading: string
  subtext?: string
  primaryCta?: CtaLink
  secondaryCta?: CtaLink
}

const { imageUrl, imageAlt = '', heading, subtext, primaryCta, secondaryCta } = Astro.props as Props
---

<section class="relative">
  <div class="h-[320px] md:h-[420px] bg-ink-500/20 overflow-hidden">
    {
      imageUrl ? (
        <img src={imageUrl} alt={imageAlt} class="w-full h-full object-cover" />
      ) : (
        <div class="w-full h-full flex items-center justify-center text-ink-500 bg-gray-200">
          <span class="text-sm">Image here</span>
        </div>
      )
    }
  </div>

  <div class="container max-w-container mx-auto px-4">
    <div class="bg-white rounded-card shadow-xl p-8 -mt-16 md:-mt-20 md:ml-auto md:w-[420px]">
      <h1 class="text-display-md md:text-display-lg">{heading}</h1>
      {subtext && <p class="mt-3 text-ink-700">{subtext}</p>}
      {
        (primaryCta || secondaryCta) && (
          <div class="mt-6 flex flex-wrap gap-3">
            {primaryCta && (
              <a href={primaryCta.href} class="rounded-pill bg-brand-sky text-white px-6 py-3 font-medium">
                {primaryCta.label}
              </a>
            )}
            {secondaryCta && (
              <a
                href={secondaryCta.href}
                class="rounded-pill border border-brand-sky text-brand-sky px-6 py-3 font-medium"
              >
                {secondaryCta.label}
              </a>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>
