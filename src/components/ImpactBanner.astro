---
import type { CtaLink } from './Hero.astro'

export interface Props {
  eyebrow?: string
  heading: string
  body?: string
  bullets?: string[]
  imageUrl?: string
  imageAlt?: string
  cta?: CtaLink
}

const { eyebrow, heading, body, bullets, imageUrl, imageAlt = '', cta } = Astro.props as Props
---

<section class="bg-brand-navy text-white rounded-card overflow-hidden">
  <div class="grid md:grid-cols-2 gap-8 items-center p-8 md:p-12">
    <div>
      {eyebrow && <p class="text-eyebrow uppercase text-brand-sky font-semibold">{eyebrow}</p>}
      <h2 class="mt-2 text-display-sm md:text-display-md">{heading}</h2>
      {body && <p class="mt-4 text-white/85">{body}</p>}
      {
        bullets && bullets.length > 0 && (
          <ul class="mt-4 space-y-2 text-brand-sky/90">
            {bullets.map((b) => (
              <li class="flex gap-2">
                <span aria-hidden="true">•</span>
                <span class="text-white/90">{b}</span>
              </li>
            ))}
          </ul>
        )
      }
      {
        cta && (
          <a href={cta.href} class="mt-6 inline-block rounded-pill bg-brand-sky text-white px-6 py-3 font-medium">
            {cta.label}
          </a>
        )
      }
    </div>
    <div class="rounded-card overflow-hidden h-64 md:h-80">
      {
        imageUrl ? (
          <img src={imageUrl} alt={imageAlt} class="w-full h-full object-cover" />
        ) : (
          <div class="w-full h-full bg-white/10 flex items-center justify-center text-white/60 text-sm">
            Image here
          </div>
        )
      }
    </div>
  </div>
</section>
