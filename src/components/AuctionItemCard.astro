---
import type { AuctionItem } from '../lib/content/types'
import Button from './Button.astro'
import Card from './Card.astro'

export interface Props {
  item: AuctionItem
}

const { item } = Astro.props as Props
---

<Card overflowHidden>
  <div class="h-32 bg-gray-200">
    {
      item.imageUrl ? (
        <img src={item.imageUrl} alt={item.name} class="w-full h-full object-cover" />
      ) : (
        <div class="w-full h-full flex items-center justify-center text-ink-500 text-sm">Image here</div>
      )
    }
  </div>
  <div class="p-4">
    <p class="font-display text-brand-navy">{item.name}</p>
    {item.estimatedValue && <p class="text-sm text-ink-500">Value: {item.estimatedValue}</p>}
    {
      item.bidUrl && (
        <Button href={item.bidUrl} variant="primary-sky" size="sm" class="mt-3 inline-block">
          Bid Now
        </Button>
      )
    }
  </div>
</Card>
