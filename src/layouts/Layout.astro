---
import '../index.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Victoria Venezuela Foundation - Empowering communities' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="description" content={description}/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
   <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
    <style is:global>
      :root {
         --color-navy: #0B2C52;
         --color-navy-dark: #081F3A;
         --color-sky: #29A9E1;
         --color-pastel-yellow: #F7E7B4;
         --color-pastel-pink: #F8D6DC;
         --color-pastel-blue: #CFE9F7;
         --color-gray-900: #111827;
         --color-gray-800: #1F2937;
         --color-gray-700: #4B5563;
         --color-gray-600: #6B7280;
         --color-gray-50: #F9FAFB;
         --color-white: #FFFFFF;
         --font-display: 'Baloo 2', system-ui, -apple-system, sans-serif;
         --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
       }
       
       * {
         margin: 0;
         padding: 0;
         box-sizing: border-box;
       }
       
       body {
         font-family: var(--font-sans);
         line-height: 1.6;
         color: var(--color-gray-900);
       }
       
       a {
         color: var(--color-sky);
         text-decoration: none;
       }

       h1, h2, h3, h4, .font-display {
         font-family: var(--font-display);
         font-weight: 700;
       }
       
       a:hover {
         text-decoration: underline;
       }
       
       img {
         max-width: 100%;
         height: auto;
       }
     </style>
   </head>
  <body class="font-sans antialiased">
    <slot/>
   </body>
</html>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const mobileMenuButton = document.querySelector('button[aria-label="Mobile menu"]') || 
                           document.querySelector('button.flex.md\\:hidden');
     
     if (mobileMenuButton) {
       mobileMenuButton.addEventListener('click', function() {
         const nav = this.closest('header').querySelector('nav');
         const menu = nav.querySelector('ul.hidden.md\\:flex');
         if (menu) {
           menu.classList.toggle('hidden');
           menu.classList.toggle('absolute');
           menu.classList.toggle('inset-x-0');
           menu.classList.toggle('top-full');
           menu.classList.toggle('bg-white');
           menu.classList.toggle('shadow-lg');
           menu.classList.toggle('flex');
           menu.classList.toggle('flex-col');
           menu.classList.toggle('p-4');
           menu.classList.toggle('space-y-4');
         }
       });
     }
   });
</script>
