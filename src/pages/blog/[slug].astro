---
import PageLayout from '../../layouts/PageLayout.astro'
import NewsletterSignup from '../../components/NewsletterSignup.astro'
import { getPostBySlug, getFeaturedPosts } from '../../lib/content'

const post = await getPostBySlug(Astro.params.slug!)
if (!post) return new Response('Not found', { status: 404 })
const featuredSidebar = await getFeaturedPosts()
---

<PageLayout title={`${post.title} — Victoria Venezuela Foundation`}>
  <section class="container max-w-container mx-auto px-4 py-10">
    <p class="text-center text-eyebrow uppercase text-brand-sky font-semibold">
      Last updated {new Date(post.updatedAt ?? post.publishedAt).toLocaleDateString()}
    </p>
    <h1 class="mt-2 text-display-lg text-center">{post.title}</h1>
    {post.author && <p class="mt-2 text-center text-ink-500">{post.author}</p>}

    <div class="mt-8 grid md:grid-cols-[1fr_320px] gap-8">
      <div class="prose max-w-none text-ink-700">
        {post.body ? <p>{post.body}</p> : <p>Full article body pending final copy from the foundation.</p>}
      </div>
      <aside class="space-y-6">
        <NewsletterSignup />
        <div>
          <h3 class="font-display text-lg text-brand-navy">Featured</h3>
          <div class="mt-3 space-y-4">
            {
              featuredSidebar
                .filter((p) => p.slug !== post.slug)
                .map((p) => (
                  <a href={`/blog/${p.slug}`} class="flex gap-3">
                    <div class="w-16 h-16 shrink-0 bg-gray-200 rounded-lg" />
                    <div>
                      <p class="text-xs text-ink-500">{new Date(p.publishedAt).toLocaleDateString()}</p>
                      <p class="text-sm font-semibold text-brand-navy">{p.title}</p>
                    </div>
                  </a>
                ))
            }
          </div>
        </div>
      </aside>
    </div>
  </section>
</PageLayout>
