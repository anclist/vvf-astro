---
import PageLayout from '../../layouts/PageLayout.astro'
import BlogCard from '../../components/BlogCard.astro'
import NewsletterSignup from '../../components/NewsletterSignup.astro'
import { getPosts, getFeaturedPosts } from '../../lib/content'

const posts = await getPosts()
const featuredSidebar = await getFeaturedPosts()
const featured = posts[0]
const categories = ['View all', 'Stories', 'Events', 'Financials', 'News'] as const
---

<PageLayout title="Blog — Victoria Venezuela Foundation">
  <section class="container max-w-container mx-auto px-4 py-10">
    <h1 class="text-display-md text-center">Blog</h1>

    {
      featured && (
        <div class="mt-8 grid md:grid-cols-2 gap-6 items-center bg-gray-50 rounded-card p-6">
          <div class="h-56 bg-gray-200 rounded-card overflow-hidden">
            {featured.imageUrl ? (
              <img src={featured.imageUrl} alt={featured.title} class="w-full h-full object-cover" />
            ) : (
              <div class="w-full h-full flex items-center justify-center text-ink-500 text-sm">Image here</div>
            )}
          </div>
          <div>
            <p class="text-sm text-ink-500">{new Date(featured.publishedAt).toLocaleDateString()}</p>
            <h2 class="mt-1 text-display-sm">{featured.title}</h2>
            {featured.excerpt && <p class="mt-2 text-ink-700">{featured.excerpt}</p>}
            <a href={`/blog/${featured.slug}`} class="mt-3 inline-block rounded-pill border border-brand-sky text-brand-sky px-5 py-2 font-medium">
              Learn More
            </a>
          </div>
        </div>
      )
    }

    <div class="mt-8 grid md:grid-cols-[1fr_320px] gap-8">
      <div>
        <div class="flex flex-wrap gap-2" data-category-pills>
          {
            categories.map((c) => (
              <button
                type="button"
                class:list={[
                  'rounded-pill border px-4 py-2 text-sm font-medium',
                  c === 'View all' && 'bg-brand-sky text-white',
                ]}
                data-category={c}
              >
                {c}
              </button>
            ))
          }
        </div>

        <p class="mt-4 text-sm text-ink-500" data-result-count>
          Showing {posts.length} of {posts.length}
        </p>

        <div class="mt-4 grid sm:grid-cols-2 gap-6" data-post-grid>
          {
            posts.map((post) => (
              <div data-post-card data-category={post.category}>
                <BlogCard post={post} />
              </div>
            ))
          }
        </div>
      </div>

      <aside class="space-y-6">
        <NewsletterSignup />
        <div>
          <h3 class="font-display text-lg text-brand-navy">Featured</h3>
          <div class="mt-3 space-y-4">
            {
              featuredSidebar.map((post) => (
                <a href={`/blog/${post.slug}`} class="flex gap-3">
                  <div class="w-16 h-16 shrink-0 bg-gray-200 rounded-lg" />
                  <div>
                    <p class="text-xs text-ink-500">{new Date(post.publishedAt).toLocaleDateString()}</p>
                    <p class="text-sm font-semibold text-brand-navy">{post.title}</p>
                  </div>
                </a>
              ))
            }
          </div>
        </div>
      </aside>
    </div>
  </section>
</PageLayout>

<script>
  const pillsContainer = document.querySelector<HTMLElement>('[data-category-pills]')
  const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category]'))
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-post-card]'))
  const resultCount = document.querySelector<HTMLElement>('[data-result-count]')
  const total = cards.length

  function applyCategory(category: string) {
    pills.forEach((p) => {
      const active = p.dataset.category === category
      p.classList.toggle('bg-brand-sky', active)
      p.classList.toggle('text-white', active)
    })
    let visible = 0
    cards.forEach((card) => {
      const match = category === 'View all' || card.dataset.category === category
      card.hidden = !match
      if (match) visible += 1
    })
    if (resultCount) resultCount.textContent = `Showing ${visible} of ${total}`
  }

  pillsContainer?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-category]')
    if (btn?.dataset.category) applyCategory(btn.dataset.category)
  })

  const initialCategory = new URLSearchParams(window.location.search).get('category')
  if (initialCategory) applyCategory(initialCategory)
</script>
