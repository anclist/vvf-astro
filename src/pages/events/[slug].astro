---
import PageLayout from '../../layouts/PageLayout.astro'
import TicketCard from '../../components/TicketCard.astro'
import SponsorshipTierTable from '../../components/SponsorshipTierTable.astro'
import AuctionItemCard from '../../components/AuctionItemCard.astro'
import StatTileRow from '../../components/StatTileRow.astro'
import TestimonialCarousel from '../../components/TestimonialCarousel.astro'
import { getEventBySlug } from '../../lib/content'
import { eventTicketUrl, eventSponsorUrl } from '../../lib/donorbox'

const event = await getEventBySlug(Astro.params.slug!)
if (!event) return new Response('Not found', { status: 404 })
const dateLabel = new Date(event.startDate).toLocaleDateString(undefined, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
---

<PageLayout title={`${event.title} — Victoria Venezuela Foundation`}>
  <section class="bg-brand-navy text-white">
    <div class="container max-w-container mx-auto px-4 py-12">
      <p class="text-white/70">{dateLabel} · {event.location}</p>
      <h1 class="mt-2 text-display-lg">{event.title}</h1>
      {event.description && <p class="mt-3 text-white/85 max-w-xl">{event.description}</p>}
      {
        event.donorboxEventId && (
          <div class="mt-6 flex gap-3">
            <a href={eventTicketUrl(event.donorboxEventId)} class="rounded-pill bg-brand-sky text-white px-6 py-3 font-medium">
              Buy Tickets
            </a>
            <a href={eventSponsorUrl(event.donorboxEventId)} class="rounded-pill border border-white/60 px-6 py-3 font-medium">
              Become a Sponsor
            </a>
          </div>
        )
      }
    </div>
  </section>

  {
    event.sponsors && event.sponsors.length > 0 && (
      <section class="container max-w-container mx-auto px-4 py-section-sm">
        <p class="text-center text-ink-500 mb-4">Thank you to our sponsors</p>
        <div class="flex flex-wrap justify-center gap-8 text-ink-700">
          {event.sponsors.map((s) => (
            <span>{s.name}</span>
          ))}
        </div>
      </section>
    )
  }

  {
    event.donorboxEventId && (
      <section class="container max-w-container mx-auto px-4 pb-section-sm md:pb-section">
        <h2 class="text-display-md text-center">Tickets</h2>
        <div class="mt-8 grid md:grid-cols-2 gap-6 max-w-2xl mx-auto">
          <TicketCard tierName="Player Foursome" price="$3,100" href={eventTicketUrl(event.donorboxEventId)} tone="yellow" />
          <TicketCard tierName="Single Player" price="$275" href={eventTicketUrl(event.donorboxEventId)} tone="blue" />
        </div>
      </section>
    )
  }

  {
    event.sponsorPackages && event.sponsorPackages.length > 0 && event.donorboxEventId && (
      <section class="container max-w-container mx-auto px-4 pb-section-sm md:pb-section">
        <h2 class="text-display-md text-center">Sponsor Packages</h2>
        <div class="mt-8">
          <SponsorshipTierTable
            tiers={event.sponsorPackages}
            ctaHrefFor={(tier) => eventSponsorUrl(event.donorboxEventId!, tier.tierName)}
          />
        </div>
      </section>
    )
  }

  {
    event.auctionItems && event.auctionItems.length > 0 && (
      <section class="container max-w-container mx-auto px-4 pb-section-sm md:pb-section">
        <h2 class="text-display-md text-center">Silent Auction</h2>
        <div class="mt-8 grid md:grid-cols-3 gap-6">
          {event.auctionItems.map((item) => <AuctionItemCard item={item} />)}
        </div>
      </section>
    )
  }

  <section class="container max-w-container mx-auto px-4 pb-section-sm md:pb-section">
    <h2 class="text-display-md text-center">Our Impact</h2>
    <div class="mt-8">
      <StatTileRow
        stats={[
          { value: '77,300+', label: 'Meals served' },
          { value: '1,012', label: 'Medical care' },
          { value: '41+', label: 'Sponsors' },
        ]}
      />
    </div>
  </section>

  <section class="container max-w-container mx-auto px-4 pb-section-sm md:pb-section">
    <h2 class="text-display-md text-center">Hear from our community</h2>
    <div class="mt-8">
      <TestimonialCarousel items={[{ title: 'Embajadora Oriana Perez' }, { title: 'A supporter shares their story' }]} />
    </div>
  </section>
</PageLayout>
