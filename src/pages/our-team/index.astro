---
import PageLayout from '../../layouts/PageLayout.astro'
import TeamMemberCard from '../../components/TeamMemberCard.astro'
import { getTeamMembers } from '../../lib/content'

const board = await getTeamMembers('board')
const leaders = await getTeamMembers('leader')
const staff = await getTeamMembers('staff')
---

<PageLayout title="Our Team — Victoria Venezuela Foundation">
  <section class="bg-gray-100">
    <div class="container max-w-container mx-auto px-4 py-12">
      <div class="bg-white rounded-card shadow p-8 max-w-xl ml-auto">
        <h1 class="text-display-md">Our Team</h1>
        <p class="mt-3 text-ink-700">
          The people who serve Venezuela come from different places and different lives, but they share one
          thing—a commitment to help those who suffer.
        </p>
      </div>
    </div>
  </section>

  <section class="container max-w-container mx-auto px-4 py-section-sm md:py-section">
    <p class="text-eyebrow uppercase text-brand-sky font-semibold text-center">The board</p>
    <h2 class="mt-2 text-display-md text-center">Board of Directors</h2>
    <div class="mt-8 grid md:grid-cols-3 gap-6">
      {board.map((m) => <TeamMemberCard member={m} />)}
    </div>
  </section>

  <section class="container max-w-container mx-auto px-4 pb-section-sm md:pb-section">
    <p class="text-eyebrow uppercase text-brand-sky font-semibold text-center">Leadership</p>
    <h2 class="mt-2 text-display-md text-center">Our Leaders</h2>
    <div class="mt-8 grid md:grid-cols-3 gap-6">
      {leaders.map((m) => <TeamMemberCard member={m} />)}
    </div>
  </section>

  <section class="container max-w-container mx-auto px-4 pb-section-sm md:pb-section">
    <p class="text-eyebrow uppercase text-brand-sky font-semibold text-center">Staff</p>
    <h2 class="mt-2 text-display-md text-center">The Team</h2>
    <div class="mt-8 grid md:grid-cols-4 gap-6">
      {staff.map((m) => <TeamMemberCard member={m} />)}
    </div>
  </section>

  <section id="volunteer" class="container max-w-container mx-auto px-4 pb-section-sm md:pb-section">
    <div class="bg-brand-navy text-white rounded-card p-8 md:p-12">
      <p class="text-eyebrow uppercase text-brand-sky font-semibold">Community</p>
      <h2 class="mt-2 text-display-sm">Our volunteers make it work</h2>
      <p class="mt-3 text-white/85 max-w-xl">
        Our work is powered by dedicated volunteers. They give their time, their skills, and their hearts to serve
        the Venezuelan people.
      </p>
      <div class="mt-6 flex gap-3">
        <a href="/contact" class="rounded-pill bg-brand-sky text-white px-6 py-3 font-medium">Volunteer</a>
        <a href="/contact" class="rounded-pill border border-white/60 px-6 py-3 font-medium">Learn</a>
      </div>
    </div>
  </section>
</PageLayout>
