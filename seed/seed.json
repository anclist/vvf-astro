    "faqs": [
      {
        "id": "faq-sponsorship-cost",
        "status": "published",
        "data": {
          "question": "How much does sponsorship cost?",
          "answer": "Sponsorship starts at $25 per month. You choose the amount that fits your budget. Your gifts fund the meals, medical care and education programs that reach every child in our care.",
          "category": "sponsorship",
          "order": 1
        }
      },
      {
        "id": "faq-where-money-goes",
        "status": "published",
        "data": {
          "question": "Where does my money go?",
          "answer": "Your sponsorship funds provide weekly meals, quarterly medical checkups, school supplies and uniforms, and faith-based teaching. In fiscal 2025, 95% of funds went directly to programs.",
          "category": "sponsorship",
          "order": 2
        }
      },
      {
        "id": "faq-write-to-child",
        "status": "published",
        "data": {
          "question": "Can I write to my sponsored child?",
          "answer": "Yes. Your child will receive your letters and drawings, and they will write back to you.",
          "category": "sponsorship",
          "order": 3
        }
      },
      {
        "id": "faq-tax-deductible",
        "status": "published",
        "data": {
          "question": "Are donations tax-deductible?",
          "answer": "Yes. Victoria Venezuela Foundation is a 501(c)(3) nonprofit organization. All donations are tax-deductible to the fullest extent allowed by law.",
          "category": "donation",
          "order": 1
        }
      },
      {
        "id": "faq-cancel-recurring",
        "status": "published",
        "data": {
          "question": "Can I cancel recurring gifts?",
          "answer": "Yes. You can change or cancel your monthly gift anytime, no questions asked.",
          "category": "donation",
          "order": 2
        }
      },
      {
        "id": "faq-tournament-format",
        "status": "published",
        "data": {
          "question": "What is the format of the tournament?",
          "answer": "A scramble format to make it fun and accessible for all skill levels.",
          "category": "tournament",
          "order": 1
        }
      },
      {
